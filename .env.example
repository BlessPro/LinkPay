APP_NAME=8Kommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
MONITORING_ERROR_TRACKING=false
MONITORING_PROVIDER=sentry
MONITORING_DSN=
MONITORING_ENVIRONMENT=${APP_ENV}
SENTRY_LARAVEL_DSN=
MONITORING_RECON_CRITICAL_THRESHOLD=1
MONITORING_RECON_HIGH_THRESHOLD=3
COUPON_IP_REUSE_BLOCK_HOURS=24

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=linkpay
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_LENGTH=6
PIN_LENGTH=4
PIN_MAX_LOGIN_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=900
PIN_ENFORCE_WEAK_DENYLIST=true
PIN_WEAK_VALUES=0000,1111,1234,2222,3333,4444,5555,6666,7777,8888,9999

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=${APP_URL}/pay/success
PAYSTACK_CURRENCY=GHS
PLATFORM_FEE_FLAT=0
PAYSTACK_SUBACCOUNT_PERCENT_CHARGE=0

# Twilio (SMS + Verify OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender (sandbox default): whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Twilio Verify Service SID must start with "VA" to use Verify OTP.
TWILIO_VERIFY_SERVICE_SID=
# Optional: used for SMS fallback (MG...).
TWILIO_MESSAGING_SERVICE_SID=
# Optional alternative for SMS fallback (a Twilio phone number, e.g. +1...).
TWILIO_SMS_FROM=
TWILIO_DEFAULT_COUNTRY=+233
TWILIO_VERIFY_DEFAULT_CHANNEL=sms
TWILIO_OTP_FALLBACK_CHANNEL=sms
TWILIO_STATUS_CALLBACK_URL=${APP_URL}/webhooks/twilio/status

# Hubtel SMS
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_BASE_URL=https://smsc.hubtel.com/v1/messages/send

VITE_APP_NAME="${APP_NAME}"
